# Copy to app/.env and fill in real values. app/.env is git-ignored.
# Key names match what docker-compose injects into the php/worker containers.

# --- Database (MySQL) ---
DB_HOST=db_webhook
DB_DATABASE=db_webhook
DB_USERNAME=root
DB_PASSWORD=root
DB_DRIVER=mysql

# --- Redis (queue / retry / DLQ) ---
REDIS_HOST=redis
REDIS_PORT=6379

# --- Webhook signing secrets (optional until each provider is wired) ---
# GitHub: repo/org webhook "Secret"
GITHUB_WEBHOOK_SECRET=
# Stripe: the whsec_... signing secret of the webhook endpoint
STRIPE_WEBHOOK_SECRET=
# PayPal: webhook id + API credentials for verify-webhook-signature
PAYPAL_WEBHOOK_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
