# Copy this file to .env and fill in real values. .env is git-ignored.

# --- Database (MySQL) ---
DB_DATABASE=db_webhook
MYSQL_ROOT_PASSWORD=root

# --- Webhook signing secrets (read from env, never hardcode) ---
# GitHub: repo/org webhook "Secret"
GITHUB_WEBHOOK_SECRET=
# Stripe: the whsec_... signing secret of the webhook endpoint
STRIPE_WEBHOOK_SECRET=
# PayPal: the webhook id + API credentials used for verify-webhook-signature
PAYPAL_WEBHOOK_ID=
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
